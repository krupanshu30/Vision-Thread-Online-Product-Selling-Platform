# Node.js dependencies
node_modules/
backend/node_modules/

# Environment variables (DO NOT commit secrets)
.env
backend/.env
*.env

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# VS Code workspace
.vscode/

# Media & large raw recordings
*.MOV
*.mov
*.mp4
*.avi

# Temporary files
*.tmp
*.bak

# Windows shortcuts
*.lnk

# Word docs
*.docx

# Bat scripts (optional, keep if needed)
# *.bat

# Google URL shortcuts
Google.url

# Vercel local config (contains project IDs - optional to commit)
# .vercel

# SQL exports (large, not needed in repo)
vision_thread_db_export.sql

# NOTE: backend/uploads/ and backend/data/ are intentionally NOT ignored
# so product images and the products cache are included in the git repo
# and available to Vercel's serverless function at runtime.

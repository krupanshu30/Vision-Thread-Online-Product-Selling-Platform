# Vision Thread Backend - Environment Variables
# ============================================================
# IMPORTANT: Never commit this file to git/version control!
# Copy this file to .env and fill in your actual values.

# --- MySQL Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Root@123
DB_NAME=vision_thread_db

# --- JWT Secret (generate a strong random string!) ---
JWT_SECRET=vision_thread_super_secret_jwt_key_change_this_in_production_2026
JWT_EXPIRES_IN=24h

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Admin Credentials (used for first-time seed only) ---
ADMIN_EMAIL=admin@visionthread.in
ADMIN_PASSWORD=Admin@123

# --- CORS (your frontend URL) ---
FRONTEND_URL=http://127.0.0.1:5500

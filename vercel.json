{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/backend/admin-panel/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/backend/admin-panel/$1"
    }
  ]
}

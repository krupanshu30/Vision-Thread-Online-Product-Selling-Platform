{
  "version": 2,
  "name": "vision-thread",
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/admin/(.*)",
      "dest": "backend/admin-panel/$1"
    },
    {
      "src": "/admin",
      "dest": "backend/admin-panel/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
